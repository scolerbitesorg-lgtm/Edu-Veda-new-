# =========================================================
# Edu Veda Deployment Environment Variables
# Compatible with Vercel, Netlify, GitHub Pages, Render, etc.
# =========================================================

# 1. Gemini AI API Key
# For Vercel Serverless: Set GEMINI_API_KEY in Vercel Project Settings > Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# For Client-Side / Pure Static Hosting (e.g., GitHub Pages):
VITE_GEMINI_API_KEY=""

# 2. Application Base URL
APP_URL="MY_APP_URL"

# 3. Firebase Configuration (Optional: defaults to firebase-applet-config.json)
# If deploying with custom Firebase project, populate these:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
